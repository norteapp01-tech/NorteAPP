# Copie para .env e preencha com os valores dos respectivos painéis.
# A anon key é pública por design (segura para o client) — a senha do Postgres e a
# service_role NUNCA devem entrar aqui nem em nenhum outro arquivo deste repositório.
OPENAI_API_KEY=
VITE_SUPABASE_URL=https://yorlxyoixeeqlcjrwasf.supabase.co
VITE_SUPABASE_ANON_KEY=
# Mapa da gravação de Esportes (estilo Dark) — sem isso, a gravação continua
# funcionando (distância/tempo/percurso), só o mapa mostra "indisponível".
VITE_MAPBOX_TOKEN=
# Chave pública VAPID (Web Push) — é pública por design, igual a anon key. A
# chave PRIVADA nunca entra aqui: vive só como secret da Edge Function
# dispatch-reminders (supabase secrets set VAPID_PRIVATE_KEY=...).
VITE_VAPID_PUBLIC_KEY=
